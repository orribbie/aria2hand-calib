+yor-calib-auto --arm left --count 12 --camera-host 127.0.0.1 \
+  --require-fresh --refine-template --seed 123 --output data/holdout60
+python tools/validate_calibration.py --data data/holdout60 \
+  --calibration data/train60/hand_eye_calibration_left.npz
+```
