+def correct_marker_points(xyz, correction):
+    """Apply a mounting correction in the nominal marker's centered frame.
+
+    Marker +x is TL->TR, +y is TL->BL, +z is their cross product.
+    The correction maps actual marker coordinates into that nominal frame.
+    """
+    correction = rigid_transform(correction)
+    center = xyz.mean(axis=1, keepdims=True)
+    a, b = xyz[:, 1]-xyz[:, 0], xyz[:, 3]-xyz[:, 0]
+    a = a / np.linalg.norm(a, axis=1, keepdims=True)
+    b = b / np.linalg.norm(b, axis=1, keepdims=True)
+    basis = np.stack([a, b, np.cross(a, b)], axis=2)
+    local = np.einsum('nji,nkj->nki', basis, xyz-center)
+    local = local @ correction[:3, :3].T + correction[:3, 3]
+    return center + np.einsum('nij,nkj->nki', basis, local)
+
+
