+    if not np.isfinite(threshold_px) or threshold_px <= 0:
+        raise ValueError('threshold_px must be positive')
+    # Reuse the ordinary fitter's input and spatial-diversity validation.
+    # A relaxed initialization gate is not the final acceptance threshold.
+    T0, _, _ = estimate_extrinsics(xyz, uv, K, D, threshold_px=max(30., threshold_px))
+    if len(xyz) < 12:
+        raise ValueError('Mount fitting requires at least 12 varied poses')
+    D = np.zeros(5) if D is None else D
+    z0 = np.r_[cv2.Rodrigues(T0[:3, :3])[0].ravel(), T0[:3, 3], np.zeros(6)]
+
+    def correction(z):
+        result = np.eye(4)
+        result[:3, :3] = cv2.Rodrigues(z[6:9])[0]
+        result[:3, 3] = z[9:12]
+        return result
+
+    def residual(z):
+        points = correct_marker_points(xyz, correction(z))
+        predicted = cv2.projectPoints(points.reshape(-1, 3), z[:3], z[3:6], K, D)[0]
+        return (predicted.reshape(uv.shape)-uv).ravel()
+
+    bounds = np.r_[np.full(6, np.inf), np.full(3, np.deg2rad(20)), np.full(3, .05)]
